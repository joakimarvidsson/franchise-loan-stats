---
import { fmtPct } from '../lib/format';
type Row = { label: string; rate: { pct: number; lo: number; hi: number } | null; n?: number; me?: boolean; href?: string };
interface Props { rows: Row[]; }
const rows = Astro.props.rows.filter((r) => r.rate);
const max = Math.max(10, ...rows.map((r) => Math.min(100, r.rate!.hi))) * 1.08;
const w = (v: number) => `${Math.max(0, Math.min(100, (v / max) * 100)).toFixed(2)}%`;
---
<div class="bars" role="img" aria-label={rows.map((r) => `${r.label}: ${fmtPct(r.rate!.pct)}`).join('; ')}>
  {rows.map((r) => (
    <div class="bar-row">
      <div>{r.href ? <a href={r.href}>{r.label}</a> : r.label}{r.n !== undefined && <span class="muted small"> · {r.n.toLocaleString('en-US')} loans</span>}</div>
      <div class="bar-track">
        <div class:list={['bar-fill', { me: r.me }]} style={`width:${w(r.rate!.pct)}`}></div>
        <div class="bar-ci" style={`left:${w(r.rate!.lo)};width:calc(${w(r.rate!.hi)} - ${w(r.rate!.lo)})`}></div>
      </div>
      <div class="bar-val">{fmtPct(r.rate!.pct)}</div>
    </div>
  ))}
  <p class="small muted">Share of disbursed loans later charged off. The thin line is the 95% confidence interval.</p>
</div>
