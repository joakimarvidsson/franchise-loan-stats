---
// Stacked bars: disbursed loans per approval fiscal year, split by outcome so far.
type Y = { fy: number; pif: number; chgoff: number; active: number };
interface Props { years: Y[]; label: string; }
const { years, label } = Astro.props;
const W = 720, H = 220, L = 34, B = 26, T = 8;
const max = Math.max(1, ...years.map((y) => y.pif + y.chgoff + y.active));
const n = years.length;
const bw = (W - L) / Math.max(n, 1);
const sy = (v: number) => ((H - B - T) * v) / max;
const ticks = [0, 0.5, 1].map((f) => Math.round(max * f));
const step = n > 24 ? 4 : n > 12 ? 2 : 1;
---
<svg class="chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
  {ticks.map((t) => (
    <g>
      <line x1={L} x2={W} y1={H - B - sy(t)} y2={H - B - sy(t)} stroke="#dfe4ec" stroke-width="1" />
      <text x={L - 5} y={H - B - sy(t) + 4} text-anchor="end" font-size="11" fill="#6b7689">{t}</text>
    </g>
  ))}
  {years.map((y, i) => {
    const x = L + i * bw + bw * 0.12, w = bw * 0.76;
    const hp = sy(y.pif), hc = sy(y.chgoff), ha = sy(y.active);
    return (
      <g>
        <title>{`FY${y.fy}: ${y.pif} paid in full, ${y.chgoff} charged off, ${y.active} still active`}</title>
        <rect x={x} y={H - B - hp} width={w} height={hp} fill="#0b6e69" />
        <rect x={x} y={H - B - hp - hc} width={w} height={hc} fill="#b4532a" />
        <rect x={x} y={H - B - hp - hc - ha} width={w} height={ha} fill="#9aa5b8" />
        {i % step === 0 && <text x={x + w / 2} y={H - 8} text-anchor="middle" font-size="11" fill="#6b7689">{`'${String(y.fy).slice(2)}`}</text>}
      </g>
    );
  })}
</svg>
<p class="legend"><span><i style="background:#0b6e69"></i>Paid in full</span><span><i style="background:#b4532a"></i>Charged off</span><span><i style="background:#9aa5b8"></i>Still active</span></p>
